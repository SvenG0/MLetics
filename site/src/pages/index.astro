---
import Base from '../layouts/Base.astro';
---

<Base>
<a href="#inhalt" class="btn" style="position:absolute;left:-9999px;top:1rem;z-index:99"
   onfocus="this.style.left='1rem'" onblur="this.style.left='-9999px'">Zum Inhalt springen</a>

<!-- Meldet Screenreadern den Kapitelwechsel. Bei Vollbildkapiteln
     bemerkt die Vorlesesoftware den Wechsel sonst nicht. -->
<p class="sr-only" id="announcer" aria-live="polite"></p>

<!-- ── Navigation ─────────────────────────────────────── -->
<header class="nav">
  <div class="wrap">
    <div class="bar">
      <a href="#auftakt" class="mark" aria-label="MLetics — Startseite">
        <img class="mark__logo" src="assets/logo/mletics-mark-dark.png" alt="MLetics — Osteopathie &amp; Physiotherapie">
      </a>

      <nav class="bar__nav" aria-label="Hauptnavigation">
        <a href="#treat">Treat</a>
        <a href="#connect">Connect</a>
        <a href="#about">Über Maik</a>
        <a href="#galerie">Galerie</a>
      </nav>

      <a href="#kontakt" class="btn btn--solid bar__cta">Kontakt</a>

      <span class="bar__progress" aria-hidden="true"><i></i></span>
    </div>
  </div>
</header>

<!-- Kapitel-Navigation rechts -->
<nav class="rail" id="rail" aria-label="Kapitel">
  <button data-go="auftakt" aria-label="Kapitel 1: Auftakt" aria-current="true"><span></span></button>
  <button data-go="treat" aria-label="Kapitel 2: Treat"><span></span></button>
  <button data-go="connect" aria-label="Kapitel 3: Connect"><span></span></button>
  <button data-go="about" aria-label="Kapitel 4: Über Maik"><span></span></button>
  <button data-go="galerie" aria-label="Kapitel 5: Galerie"><span></span></button>
  <button data-go="kontakt" aria-label="Kapitel 6: Kontakt"><span></span></button>
</nav>

<main id="inhalt">

<!-- ── 01 AUFTAKT ─────────────────────────────────────── -->
<section class="chapter" id="auftakt" data-chapter="0">
  <!-- Kapitel-Hintergrund: scrollt normal mit. Für Video das <img>
       ersetzen durch:
       <video class="chapter__bg-img" src="assets/01-hero.mp4" poster="assets/01-hero.jpg"
              autoplay muted loop playsinline preload="none"></video> -->
  <div class="chapter__bg bg-01" aria-hidden="true">
    <img class="chapter__bg-img" src="assets/01-hero.jpg" alt="" data-media>
    <div class="chapter__bg-grade"></div>
  </div>
  <div class="wrap">
    <p class="eyebrow rise"><b>01</b> <span>MLetics by Maik Liesbrock — Bochum</span></p>
    <h1 class="display rise">UNDERSTAND. TREAT.<br>CONNECT.</h1>
    <p class="lead lead--brand rise" style="margin-top:1.25rem">Verstehen. Behandeln. Vernetzen.</p>
    <p class="lead rise" style="margin-top:1.25rem">
      Den Körper verstehen. Funktionelle Zusammenhänge erkennen. Individuell
      behandeln. Und dort, wo weitere Expertise sinnvoll ist, die richtigen
      Kompetenzen miteinander verbinden.
    </p>
    <div class="rise" style="margin-top:3rem;display:flex;gap:1rem;flex-wrap:wrap;align-items:center">
      <a href="#kontakt" class="btn btn--solid">Termin anfragen</a>
      <a href="#treat" class="btn">Leistungen ansehen</a>
    </div>
  </div>
</section>

<!-- ── 02 TREAT (Leistungen) ──────────────────────────── -->
<section class="chapter" id="treat" data-chapter="1">
  <div class="chapter__bg bg-02" aria-hidden="true">
    <img class="chapter__bg-img" src="assets/02-treat.jpg" alt="" data-media>
    <div class="chapter__bg-grade"></div>
  </div>
  <div class="wrap">
    <p class="eyebrow rise"><b>02</b> <span>Treat</span></p>
    <h2 class="display display--sm rise">Individuelle Therapie<br>statt Behandlung nach Schema.</h2>
    <p class="lead rise" style="margin-top:1.75rem">
      Auf Basis der Befundung entsteht ein individuelles Behandlungskonzept.
      Physiotherapie und osteopathische Ansätze werden dabei gezielt miteinander
      verbunden und an Deine persönliche Situation angepasst.
    </p>

    <div class="services">
      <article class="service rise">
        <span class="service__no">01</span>
        <h3>Physiotherapie</h3>
        <p>Beschwerden behandeln, Beweglichkeit verbessern und Funktionen wiederherstellen.</p>
        <ul>
          <li>Akute und chronische Beschwerden</li>
          <li>Behandlung nach Verletzungen und Operationen</li>
          <li>Funktionelle Bewegungsanalyse</li>
          <li>Individuelle Therapieplanung</li>
        </ul>
      </article>
      <article class="service rise">
        <span class="service__no">02</span>
        <h3>Sport-Osteopathie</h3>
        <p>Körperliche Zusammenhänge betrachten und funktionelle Einschränkungen ganzheitlich einordnen.</p>
        <ul>
          <li>Prävention von Sportverletzungen</li>
          <li>Optimierung von Bewegungsabläufen</li>
          <li>Förderung von Regeneration und Belastbarkeit</li>
          <li>Betreuung von Freizeit- und Leistungssportlern</li>
        </ul>
      </article>
      <article class="service rise">
        <span class="service__no">03</span>
        <h3>Sektorale Heilpraktik Physiotherapie</h3>
        <p>Eigenständige physiotherapeutische Befundung und Behandlung im Rahmen der bestehenden Erlaubnis.</p>
        <ul>
          <li>Direkter Zugang ohne ärztliche Verordnung</li>
          <li>Umfassende Befunderhebung</li>
          <li>Individuelle Behandlungskonzepte</li>
          <li>Hausbesuche nach Vereinbarung</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<!-- ── 04 CONNECT ─────────────────────────────────────── -->
<section class="chapter" id="connect" data-chapter="2">
  <div class="chapter__bg bg-03" aria-hidden="true">
    <img class="chapter__bg-img" src="assets/03-connect.jpg" alt="" data-media>
    <div class="chapter__bg-grade"></div>
  </div>
  <div class="wrap chapter__grid">
    <div>
      <p class="eyebrow rise"><b>03</b> <span>Connect</span></p>
      <h2 class="display display--sm rise">Mehr als eine<br>Perspektive.</h2>
      <p class="lead rise" style="margin-top:1.75rem">
        Ich sehe meine Arbeit als Teil eines größeren Umfelds. Wo sinnvoll,
        arbeite ich mit Athletiktrainern, Ärzten und weiteren Spezialisten
        zusammen — nicht um Kompetenzen zu ersetzen, sondern um sie zu verbinden.
      </p>
    </div>
    <div>
      <span class="tag rise">Für wen?</span>
      <div class="audience">
        <div class="audience__card rise">
          <span class="audience__icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg>
          </span>
          <p class="block-h3">Für Athlet:innen</p>
          <p class="body">
            Leistungsfähigkeit braucht einen gesunden, belastbaren Körper.
            Prävention, individuelle Behandlung und der Blick auf Belastung und
            Regeneration halten Dich dauerhaft leistungsfähig.
          </p>
        </div>
        <div class="audience__card rise">
          <span class="audience__icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
          </span>
          <p class="block-h3">Für Patient:innen</p>
          <p class="body">
            Beschwerden betreffen nicht nur den Körper, sondern das Wohlbefinden.
            Gemeinsam betrachten wir körperliche und emotionale Faktoren — für
            mehr Beweglichkeit, Belastbarkeit und Balance.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── 04 ÜBER MAIK ───────────────────────────────────── -->
<section class="chapter" id="about" data-chapter="3">
  <div class="chapter__bg bg-04" aria-hidden="true">
    <img class="chapter__bg-img" src="assets/04-about.jpg" alt="" data-media>
    <div class="chapter__bg-grade"></div>
  </div>
  <div class="wrap chapter__grid">
    <div>
      <p class="eyebrow rise"><b>04</b> <span>Über Maik</span></p>
      <h2 class="display rise">Ganzheitlich. Nachhaltig.<br>Professionell.</h2>
      <p class="lead rise" style="margin-top:2rem">
        Prävention beginnt vor der Verletzung. 16 Jahre Erfahrung im
        Profifußball prägen meinen Blick auf Körper, Belastung und
        Regeneration — nicht erst reagieren, wenn es weh tut, sondern
        verstehen, was Dein Körper braucht.
      </p>
    </div>
    <div class="rise">
      <dl class="vita">
        <div class="rise">
          <dt>Qualifikation</dt>
          <dd>Physiotherapeut, Sektoraler Heilpraktiker für Physiotherapie</dd>
        </div>
        <div class="rise">
          <dt>Schwerpunkt</dt>
          <dd>Sport-Osteopathie</dd>
        </div>
        <div class="rise">
          <dt>Erfahrung</dt>
          <dd>16 Jahre im Profifußball</dd>
        </div>
        <div class="rise">
          <dt>Station</dt>
          <dd>Physiotherapeut, VfL Bochum 1848 (Saison 2020/21)</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<!-- ── 05 GALERIE ─────────────────────────────────────── -->
<section class="chapter" id="galerie" data-chapter="4">
  <div class="wrap">
    <!-- Nur das kleine Kapitel-Label, wie bei den anderen Kapiteln —
         der große Titel und Fließtext bleiben bewusst weg, „nur die
         Bilder". h2 trägt die sichtbare Überschrift selbst (nicht mehr
         sr-only), damit sie zugleich als echte Dokument-Überschrift zählt. -->
    <p class="eyebrow rise"><b>05</b> <span>Galerie</span></p>
    <h2 class="sr-only">Galerie</h2>

    <div class="gallery rise">
      <div class="gallery__stage">
        <button class="gallery__nav gallery__nav--prev" id="galPrev" aria-label="Vorheriges Bild">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <!-- Reihenfolge nach Farbstimmung sortiert, nicht nach Dateiname —
             Schwarzweiß zum Auftakt, dann Blau, Grün, Gelb/Orange, Rot,
             ein neutrales Bild zum Herunterkühlen, zum Schluss das
             hellste, wärmste Foto. Miniaturleiste weiter unten läuft in
             derselben Reihenfolge (data-index 0-9 muss exakt hierzu
             passen, sonst zeigt ein Klick aufs falsche Bild). -->
        <div class="gallery__track" id="galTrack">
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/01.jpg" alt="Physiotherapeutisches Team im Gespräch nach dem Spiel" data-media loading="eager">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/03.jpg" alt="Physiotherapeuten laufen mit der Notfalltasche aufs Spielfeld" data-media loading="lazy">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/05.jpg" alt="Behandlung eines Spielers direkt auf dem Rasen" data-media loading="lazy">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/06.jpg" alt="Jubelumarmung mit einem Spieler an der Seitenlinie" data-media loading="lazy">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/09.jpg" alt="Faustgruß zwischen zwei Betreuern im Stadion" data-media loading="lazy">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/08.jpg" alt="Versorgung eines verletzten Spielers am Spielfeldrand" data-media loading="lazy">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/02.jpg" alt="Medizinisches Team versorgt einen Spieler auf dem Platz" data-media loading="lazy">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/07.jpg" alt="Nachdenklicher Moment auf der Ersatzbank im Stadion" data-media loading="lazy">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/04.jpg" alt="Betreuer geben Entwarnung nach einer Spielerverletzung" data-media loading="lazy">
          </figure>
          <figure class="gallery__slide">
            <span class="gallery__ph" aria-hidden="true">Foto folgt</span>
            <img src="assets/galerie/10.jpg" alt="Jubel mit der Aufstiegs-Meisterschale" data-media loading="lazy">
          </figure>
        </div>
        <button class="gallery__nav gallery__nav--next" id="galNext" aria-label="Nächstes Bild">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
      <div class="gallery__thumbs" id="galThumbs" role="tablist" aria-label="Galerie-Miniaturen">
        <button class="gallery__thumb" data-index="0" role="tab" aria-current="true" aria-label="Bild 1"><img src="assets/galerie/01.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="1" role="tab" aria-current="false" aria-label="Bild 2"><img src="assets/galerie/03.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="2" role="tab" aria-current="false" aria-label="Bild 3"><img src="assets/galerie/05.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="3" role="tab" aria-current="false" aria-label="Bild 4"><img src="assets/galerie/06.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="4" role="tab" aria-current="false" aria-label="Bild 5"><img src="assets/galerie/09.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="5" role="tab" aria-current="false" aria-label="Bild 6"><img src="assets/galerie/08.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="6" role="tab" aria-current="false" aria-label="Bild 7"><img src="assets/galerie/02.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="7" role="tab" aria-current="false" aria-label="Bild 8"><img src="assets/galerie/07.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="8" role="tab" aria-current="false" aria-label="Bild 9"><img src="assets/galerie/04.jpg" alt="" data-media loading="lazy"></button>
        <button class="gallery__thumb" data-index="9" role="tab" aria-current="false" aria-label="Bild 10"><img src="assets/galerie/10.jpg" alt="" data-media loading="lazy"></button>
      </div>
    </div>
  </div>
</section>

<!-- ── 06 KONTAKT ─────────────────────────────────────── -->
<section class="chapter" id="kontakt" data-chapter="5">
  <div class="chapter__bg bg-06" aria-hidden="true">
    <img class="chapter__bg-img" src="assets/06-kontakt.jpg" alt="" data-media>
    <div class="chapter__bg-grade"></div>
  </div>
  <div class="wrap chapter__grid" style="align-items:start">
    <div>
      <p class="eyebrow rise"><b>06</b> <span>Kontakt</span></p>
      <h2 class="display display--sm rise">Sprechen wir<br>über Deinen Weg.</h2>

      <dl class="contact-list rise">
        <div>
          <dt>Telefon</dt>
          <dd><a href="tel:+4923412345678">0234 · 123 456 78</a></dd>
        </div>
        <div>
          <dt>E-Mail</dt>
          <dd><a href="mailto:praxis@mletics.de">praxis@mletics.de</a></dd>
        </div>
        <div>
          <dt>Adresse</dt>
          <dd style="font-weight:400;font-size:1rem;line-height:1.6">
            Musterstraße 12<br>44787 Bochum
          </dd>
        </div>
        <div>
          <dt>Sprechzeiten</dt>
          <dd style="font-weight:400;font-size:1rem;line-height:1.6">
            Mo – Do &nbsp;8:00 – 19:00<br>
            Fr &nbsp;8:00 – 15:00<br>
            Termine nach Vereinbarung
          </dd>
        </div>
      </dl>
    </div>

    <div class="rise">
      <form class="form" id="form" novalidate>
        <div class="row">
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="f-tel">Telefon</label>
            <input id="f-tel" name="tel" type="tel" autocomplete="tel">
          </div>
        </div>

        <div class="field">
          <label for="f-mail">E-Mail</label>
          <input id="f-mail" name="email" type="email" autocomplete="email" required>
        </div>

        <div class="field">
          <label for="f-art">Anliegen</label>
          <select id="f-art" name="anliegen">
            <option>Ersttermin</option>
            <option>Physiotherapie</option>
            <option>Sport-Osteopathie</option>
            <option>Sektorale Heilpraktik Physiotherapie</option>
            <option>Sonstiges</option>
          </select>
        </div>

        <div class="field">
          <label for="f-msg">Nachricht</label>
          <textarea id="f-msg" name="nachricht" placeholder="Was führt Dich zu uns?"></textarea>
          <p class="hintline">Bitte keine Diagnosen oder Gesundheitsdaten im Formular senden — das klären wir persönlich.</p>
        </div>

        <label class="consent">
          <input type="checkbox" id="f-ok" required>
          <span>Ich bin einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage
          gespeichert werden. Hinweise dazu in der <a href="#" style="color:var(--accent)">Datenschutzerklärung</a>.</span>
        </label>

        <button type="submit" class="btn btn--solid" style="justify-content:center">Anfrage senden</button>
        <p class="hintline" id="formNote" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="wrap foot">
    <p style="margin:0">© 2026 MLetics by Maik Liesbrock · Bochum</p>
    <nav aria-label="Rechtliches">
      <a href="#">Impressum</a>
      <a href="#">Datenschutz</a>
    </nav>
  </div>
</footer>

<nav class="step" id="step" aria-label="Kapitel wechseln">
  <button id="stepPrev" aria-label="Vorheriges Kapitel">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 15l-6-6-6 6"/>
    </svg>
  </button>
  <span class="step__count"><b id="stepNow">01</b> / 06</span>
  <button id="stepNext" aria-label="Nächstes Kapitel">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </button>
</nav>

<!-- Kein GSAP mehr nötig — der Kapitel-Übergang läuft über CSS
     position:sticky, keine externe Skript-Abhängigkeit mehr dafür. -->
</Base>
