---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Bewusst <Image> (ein einfaches <img> mit srcset) statt <Picture>: <Picture>
// würde ein zusätzliches <picture>-Element erzeugen und damit die DOM-Struktur
// ändern, an der CSS und JS hängen. Format webp statt avif, weil avif erst ab
// Safari 16.4 (März 2023) geht — ältere iPhones bekämen sonst gar kein Bild.
interface Props {
  id: string;
  /** Nullbasiert, steuert Rail/Stepper über das JS. */
  nr: number;
  /** Farbverlauf-Rückfallebene, z.B. "bg-01". */
  bg?: string;
  /** Kapitelfoto. Fehlt es, trägt allein der Farbverlauf das Kapitel. */
  bild?: ImageMetadata;
  /** Zweispaltiges Innenlayout (Text links, Inhalt rechts). */
  grid?: boolean;
  wrapStyle?: string;
}
const { id, nr, bg, bild, grid = false, wrapStyle } = Astro.props;
---

<section class="chapter" id={id} data-chapter={nr}>
  {bg && (
    <div class={`chapter__bg ${bg}`} aria-hidden="true">
      {bild && (
        <Image
          class="chapter__bg-img"
          src={bild}
          alt=""
          widths={[640, 1024, 1600, 2400]}
          sizes="100vw"
          format="webp"
          data-media
        />
      )}
      <div class="chapter__bg-grade"></div>
    </div>
  )}
  <div class={grid ? 'wrap chapter__grid' : 'wrap'} style={wrapStyle}>
    <slot />
  </div>
</section>
