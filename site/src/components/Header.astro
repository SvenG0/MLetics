---
import { Image } from 'astro:assets';
import logo from '../assets/mletics-mark-dark.png';

interface Props {
  /** Präfix der Ankerlinks: auf der Startseite leer, auf Unterseiten "/". */
  prefix?: string;
}
const { prefix = '' } = Astro.props;
---

<header class="nav">
  <div class="wrap">
    <div class="bar">
      <a href={`${prefix}#auftakt`} class="mark" aria-label="MLetics — Startseite">
        {/* Bewusst ohne widths/sizes, also nur umcodiert statt verkleinert:
            jede Skalierung rundet die Zielmaße auf ganze Pixel und verschiebt
            damit das Seitenverhältnis minimal — das Logo wurde dadurch bei
            56px Höhe 1px schmaler als zuvor. Die Datei ist klein genug, dass
            allein PNG → WebP den Großteil der Ersparnis bringt. */}
        <Image
          class="mark__logo"
          src={logo}
          alt="MLetics — Osteopathie & Physiotherapie"
          format="webp"
        />
      </a>

      <nav class="bar__nav" aria-label="Hauptnavigation">
        <a href={`${prefix}#treat`}>Treat</a>
        <a href={`${prefix}#connect`}>Connect</a>
        <a href={`${prefix}#about`}>Über Maik</a>
        <a href={`${prefix}#galerie`}>Galerie</a>
      </nav>

      <a href={`${prefix}#kontakt`} class="btn btn--solid bar__cta">Kontakt</a>

      <span class="bar__progress" aria-hidden="true"><i></i></span>
    </div>
  </div>
</header>
