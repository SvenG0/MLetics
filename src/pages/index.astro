---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Chapter from '../components/Chapter.astro';
import Rail from '../components/Rail.astro';
import Stepper from '../components/Stepper.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AudienceCard from '../components/AudienceCard.astro';
import Gallery from '../components/Gallery.astro';
import Vita from '../components/Vita.astro';
import ContactList from '../components/ContactList.astro';
import ContactForm from '../components/ContactForm.astro';
import hero from '../assets/01-hero.jpg';
import treat from '../assets/02-treat.jpg';
import connect from '../assets/03-connect.jpg';
import about from '../assets/04-about.jpg';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const zielgruppen = (await getCollection('zielgruppen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<Base>
  <Rail />

  <main id="inhalt">

    <!-- ── 01 AUFTAKT ─────────────────────────────────────── -->
    <Chapter id="auftakt" nr={0} bg="bg-01" bild={hero}>
      <p class="eyebrow rise"><b>01</b> <span>MLetics by Maik Liesbrock — Bochum</span></p>
      <h1 class="display rise">UNDERSTAND. TREAT.<br>CONNECT.</h1>
      <p class="lead lead--brand rise" style="margin-top:1.25rem">Verstehen. Behandeln. Vernetzen.</p>
      <p class="lead rise" style="margin-top:1.25rem">
        Den Körper verstehen. Funktionelle Zusammenhänge erkennen. Individuell
        behandeln. Und dort, wo weitere Expertise sinnvoll ist, die richtigen
        Kompetenzen miteinander verbinden.
      </p>
      <div class="rise" style="margin-top:3rem;display:flex;gap:1rem;flex-wrap:wrap;align-items:center">
        <a href="#kontakt" class="btn btn--solid">Termin anfragen</a>
        <a href="#treat" class="btn">Leistungen ansehen</a>
      </div>
    </Chapter>

    <!-- ── 02 TREAT (Leistungen) ──────────────────────────── -->
    <Chapter id="treat" nr={1} bg="bg-02" bild={treat}>
      <p class="eyebrow rise"><b>02</b> <span>Treat</span></p>
      <h2 class="display display--sm rise">Individuelle Therapie<br>statt Behandlung nach Schema.</h2>
      <p class="lead rise" style="margin-top:1.75rem">
        Auf Basis der Befundung entsteht ein individuelles Behandlungskonzept.
        Physiotherapie und osteopathische Ansätze werden dabei gezielt miteinander
        verbunden und an Deine persönliche Situation angepasst.
      </p>

      <div class="services">
        {leistungen.map((l) => (
          <ServiceCard nummer={l.data.nummer} titel={l.data.titel} kurz={l.data.kurz} punkte={l.data.punkte} />
        ))}
      </div>
    </Chapter>

    <!-- ── 03 CONNECT ─────────────────────────────────────── -->
    <Chapter id="connect" nr={2} bg="bg-03" bild={connect} grid>
      <div>
        <p class="eyebrow rise"><b>03</b> <span>Connect</span></p>
        <h2 class="display display--sm rise">Mehr als eine<br>Perspektive.</h2>
        <p class="lead rise" style="margin-top:1.75rem">
          Ich sehe meine Arbeit als Teil eines größeren Umfelds. Wo sinnvoll,
          arbeite ich mit Athletiktrainern, Ärzten und weiteren Spezialisten
          zusammen — nicht um Kompetenzen zu ersetzen, sondern um sie zu verbinden.
        </p>
      </div>
      <div>
        <span class="tag rise">Für wen?</span>
        <div class="audience">
          {zielgruppen.map((z) => (
            <AudienceCard titel={z.data.titel} icon={z.data.icon} text={z.data.text} />
          ))}
        </div>
      </div>
    </Chapter>

    <!-- ── 04 ÜBER MAIK ───────────────────────────────────── -->
    <Chapter id="about" nr={3} bg="bg-04" bild={about} grid>
      <div>
        <p class="eyebrow rise"><b>04</b> <span>Über Maik</span></p>
        <h2 class="display rise">Ganzheitlich. Nachhaltig.<br>Professionell.</h2>
        <p class="lead rise" style="margin-top:2rem">
          Prävention beginnt vor der Verletzung. 16 Jahre im Profisport prägen
          meinen Blick auf Körper, Belastung und Regeneration — nicht erst
          reagieren, wenn es weh tut, sondern verstehen, was Dein Körper braucht.
        </p>
      </div>
      <div class="rise">
        <Vita />
      </div>
    </Chapter>

    <!-- ── 05 GALERIE ─────────────────────────────────────── -->
    <Chapter id="galerie" nr={4}>
      <!-- Nur das kleine Kapitel-Label, wie bei den anderen Kapiteln —
           der große Titel und Fließtext bleiben bewusst weg, „nur die
           Bilder". Die sichtbare Überschrift steht deshalb nur für
           Screenreader im Dokument. -->
      <p class="eyebrow rise"><b>05</b> <span>Galerie</span></p>
      <h2 class="sr-only">Galerie</h2>
      <Gallery />
    </Chapter>

    <!-- ── 06 KONTAKT ─────────────────────────────────────── -->
    {/* Ohne Kapitelfoto: assets/06-kontakt.jpg existiert nicht. Der Verlauf
        .bg-06 trägt das Kapitel bereits — vorher erzeugte das fehlende Bild
        bei jedem Aufruf einen 404, den JS anschließend wieder aufräumte. */}
    <Chapter id="kontakt" nr={5} bg="bg-06" grid wrapStyle="align-items:start">
      <div>
        <p class="eyebrow rise"><b>06</b> <span>Kontakt</span></p>
        <h2 class="display display--sm rise">Sprechen wir<br>über Deinen Weg.</h2>
        <ContactList />
      </div>
      <div class="rise">
        <ContactForm />
      </div>
    </Chapter>

  </main>

  <Stepper slot="ausserhalb" />
</Base>
