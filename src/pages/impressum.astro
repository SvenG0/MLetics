---
import Textseite from '../layouts/Textseite.astro';
import praxis from '../data/praxis.json';
import impressum from '../data/impressum.json';

// Pflichtangaben nach § 5 DDG (seit 2024 Nachfolger des § 5 TMG).
// Noch offene Punkte stehen in src/data/impressum.json auf null und werden
// unten sichtbar als „noch zu ergänzen" ausgewiesen — sie sollen auffallen,
// solange sie fehlen, statt still zu verschwinden.
const offen = (wert: string | null | undefined) => wert === null || wert === undefined || wert === '';
---

<Textseite
  title="Impressum — MLetics, Maik Liesbrock, Bochum"
  description="Impressum und Anbieterkennzeichnung von MLetics — Maik Liesbrock, Physiotherapie und Osteopathie in Bochum."
  ueberschrift="Impressum"
>
  <h2>Angaben gemäß § 5 DDG</h2>
  <p>
    {praxis.langname}<br />
    {praxis.inhaber}<br />
    {praxis.adresse.strasse}<br />
    {praxis.adresse.plz} {praxis.adresse.ort}<br />
    Deutschland
  </p>

  <h3>Kontakt</h3>
  <p>
    Telefon: <a href={`tel:${praxis.telefon.link}`}>{praxis.telefon.anzeige}</a><br />
    E-Mail: <a href={`mailto:${praxis.email}`}>{praxis.email}</a>
  </p>

  {/* Rechtsform entfaellt: § 5 Abs. 1 Nr. 4 DDG verlangt Register und
      Registernummer nur "soweit eingetragen". Ein Freiberufler nach § 18 EStG
      steht in keinem Handelsregister. Von acht geprueften Praxisseiten nennt
      nur eine die Rechtsform — und das ist eine GmbH, dort ist es Pflicht. */}

  <h3>Umsatzsteuer</h3>
  <p>
    Heilbehandlungen im Bereich der Humanmedizin sind nach § 4 Nr. 14 a UStG
    von der Umsatzsteuer befreit. Eine Umsatzsteuer-Identifikationsnummer nach
    § 27 a UStG liegt daher nicht vor.
  </p>

  <h2>Berufsrechtliche Angaben</h2>

  <h3>Gesetzliche Berufsbezeichnungen</h3>
  <ul>
    {impressum.berufsbezeichnungen.map((b) => (
      <li>
        {b.titel} —{' '}
        {offen(b.staat)
          ? <span class="offen">Verleihungsstaat noch zu ergänzen (in den Niederlanden erworben?)</span>
          : <>verliehen in {b.staat}</>}
      </li>
    ))}
  </ul>

  {/* Osteopathie ist in Deutschland kein reglementierter Beruf, "Osteopath"
      also keine gesetzliche Berufsbezeichnung im Sinne des § 5 Abs. 1 Nr. 5
      DDG, sondern ein akademischer Grad. Deshalb eigener Abschnitt. */}
  <h3>Akademischer Grad</h3>
  <p>
    {impressum.akademischerGrad.grad}
    {offen(impressum.akademischerGrad.hochschule)
      ? <> — <span class="offen">verleihende Hochschule noch zu ergänzen</span></>
      : <> — verliehen von {impressum.akademischerGrad.hochschule}</>}
  </p>

  <h3>Zuständige Aufsichtsbehörde</h3>
  <p>
    {impressum.aufsichtsbehoerde.name}<br />
    {impressum.aufsichtsbehoerde.anschrift}<br />
    <a href={impressum.aufsichtsbehoerde.web} target="_blank" rel="noopener noreferrer">
      {impressum.aufsichtsbehoerde.web.replace('https://', '')}
    </a>
  </p>

  <h3>Berufsrechtliche Regelungen</h3>
  <ul>
    {impressum.berufsrecht.map((g) => (
      <li><a href={g.url} target="_blank" rel="noopener noreferrer">{g.name}</a></li>
    ))}
  </ul>

  {/* Berufshaftpflicht entfaellt: Die Angabepflicht steht in § 2 Abs. 1
      Nr. 11 DL-InfoV. Die setzt die EU-Dienstleistungsrichtlinie um, und
      Gesundheitsdienstleistungen sind davon ausdruecklich ausgenommen
      (Art. 2 Abs. 2 lit. f RL 2006/123/EG). Von acht geprueften Praxisseiten
      nennt sie genau eine. Eine Versicherung zu HABEN bleibt selbstredend
      noetig — sie hier zu nennen, ist es nicht. */}

  <h2>Streitbeilegung</h2>
  <p>
    Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor
    einer Verbraucherschlichtungsstelle teilzunehmen.
  </p>
  <p>
    <em>
      Hinweis: Die früher übliche Verlinkung auf die EU-Plattform zur
      Online-Streitbeilegung entfällt — sie wurde im Juli 2025 eingestellt. Viele
      Impressum-Vorlagen führen den Link weiterhin, er geht inzwischen ins Leere.
    </em>
  </p>

  <h2>Haftung für Inhalte und Links</h2>
  <p>
    Die Inhalte dieser Seiten wurden mit Sorgfalt erstellt. Für die Richtigkeit,
    Vollständigkeit und Aktualität der Inhalte kann jedoch keine Gewähr übernommen
    werden. Als Diensteanbieter sind wir nach § 7 Abs. 1 DDG für eigene Inhalte auf
    diesen Seiten verantwortlich, nach §§ 8 bis 10 DDG jedoch nicht verpflichtet,
    übermittelte oder gespeicherte fremde Informationen zu überwachen.
  </p>
  <p>
    Unser Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte wir
    keinen Einfluss haben. Für diese fremden Inhalte ist stets der jeweilige Anbieter
    verantwortlich. Bei Bekanntwerden von Rechtsverletzungen entfernen wir
    entsprechende Links umgehend.
  </p>

  <h2>Urheberrecht</h2>
  <p>
    Die auf dieser Website veröffentlichten Inhalte und Werke unterliegen dem
    deutschen Urheberrecht. Vervielfältigung, Bearbeitung, Verbreitung und jede Art
    der Verwertung außerhalb der Grenzen des Urheberrechts bedürfen der schriftlichen
    Zustimmung des jeweiligen Autors bzw. Erstellers.
  </p>
  <p>
    Auf einzelnen Fotografien dieser Website sind Vereins- und Sponsorenkennzeichen
    Dritter erkennbar. Die Rechte an diesen Kennzeichen liegen bei den jeweiligen
    Inhabern.
  </p>
</Textseite>
