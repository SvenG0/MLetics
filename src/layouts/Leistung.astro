---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import praxis from '../data/praxis.json';

// Layout der Leistungs-Unterseiten. Bewusst OHNE die Kapitel-Maschinerie der
// Startseite: kein Stepper, keine Punktleiste, kein Vollbild-Scrollen. Eine
// Unterseite hat ein Thema — sie soll überflogen werden können, nicht in
// sechs Bildschirmen durchgeklickt.
//
// Wichtig: der Kopfbereich trägt NICHT die Klasse .chapter. Sonst fände das
// Skript der Startseite hier ein Kapitel, würde die Kapitel-Navigation starten
// und am fehlenden Stepper abbrechen. Die Bild-Ebene (.chapter__bg samt Lasur)
// wird trotzdem wiederverwendet — die hängt nicht an .chapter.

interface Abschnitt { titel: string; text: string }
interface Props {
  titel: string;
  nummer: string;
  h1: string;
  seoTitel: string;
  seoText: string;
  intro: string;
  bild: ImageMetadata;
  bg: string;
  abschnitte: Abschnitt[];
  anlaesse: { titel: string; punkte: string[] };
  ablauf: Abschnitt[];
  /** Die jeweils anderen Leistungen, für die Querverlinkung unten. */
  weitere: { id: string; nummer: string; titel: string; kurz: string }[];
  schema: unknown;
}

const {
  titel, nummer, h1, seoTitel, seoText, intro, bild, bg,
  abschnitte, anlaesse, ablauf, weitere, schema,
} = Astro.props;
---

<Base title={seoTitel} description={seoText} headerPrefix="/" schema={false}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="kopf" />

  <main id="inhalt" class="leistung">

    <!-- ── Kopf mit Foto ──────────────────────────────────────── -->
    <section class="leistung__kopf">
      <div class={`chapter__bg ${bg}`} aria-hidden="true">
        <Image
          class="chapter__bg-img"
          src={bild}
          alt=""
          widths={[640, 1024, 1600, 2400]}
          sizes="100vw"
          format="webp"
          data-media
        />
        <div class="chapter__bg-grade"></div>
      </div>

      <div class="wrap">
        <nav class="krume" aria-label="Sie sind hier">
          <a href="/">Start</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{titel}</span>
        </nav>

        <p class="eyebrow"><b>{nummer}</b> <span>Leistung</span></p>
        <h1 class="display display--sm">{h1}</h1>
        <p class="lead" style="margin-top:1.75rem">{intro}</p>

        <div class="leistung__aktionen">
          <a href="/#kontakt" class="btn btn--solid">Termin anfragen</a>
          <a href={`tel:${praxis.telefon.link}`} class="btn">{praxis.telefon.anzeige}</a>
        </div>
      </div>
    </section>

    <!-- ── Fließtext ──────────────────────────────────────────── -->
    <section class="wrap leistung__text">
      {abschnitte.map((a) => (
        <div class="block">
          <h2 class="block-h3">{a.titel}</h2>
          <p class="body">{a.text}</p>
        </div>
      ))}
    </section>

    <!-- ── Anlässe ────────────────────────────────────────────── -->
    <section class="wrap leistung__anlaesse">
      <h2 class="display display--sm">{anlaesse.titel}</h2>
      <ul>
        {anlaesse.punkte.map((p) => <li>{p}</li>)}
      </ul>
    </section>

    <!-- ── Ablauf ─────────────────────────────────────────────── -->
    <section class="wrap leistung__ablauf">
      <h2 class="display display--sm">So läuft es ab</h2>
      <ol>
        {ablauf.map((s, i) => (
          <li>
            <span class="leistung__schritt" aria-hidden="true">{('0' + (i + 1)).slice(-2)}</span>
            <h3>{s.titel}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── Abschluss + Querverweise ───────────────────────────── -->
    <section class="wrap leistung__schluss">
      <div class="leistung__cta">
        <h2 class="display display--sm">Passt das zu Deinem Anliegen?</h2>
        <p class="body">
          Wenn Du unsicher bist, welche Behandlung die richtige ist: ruf einfach an.
          Das klären wir in fünf Minuten am Telefon, nicht im Formular.
        </p>
        <div class="leistung__aktionen">
          <a href={`tel:${praxis.telefon.link}`} class="btn btn--solid">{praxis.telefon.anzeige}</a>
          <a href="/#kontakt" class="btn">Zum Kontaktformular</a>
        </div>
      </div>

      <nav class="leistung__weitere" aria-label="Weitere Leistungen">
        <p class="eyebrow"><span>Weitere Leistungen</span></p>
        {weitere.map((w) => (
          <a href={`/${w.id}/`} class="leistung__link">
            <span class="leistung__link-no">{w.nummer}</span>
            <span>
              <strong>{w.titel}</strong>
              <em>{w.kurz}</em>
            </span>
          </a>
        ))}
      </nav>
    </section>

  </main>
</Base>
