---
// Leistungskarte — bewusst OHNE Bildzeichen: Die Überschrift soll allein
// vorne stehen, wie in Kapitel 03. Damit hat die Seite nun gar keine
// dekorativen Icons mehr; die einzigen verbliebenen SVGs sind die
// Pfeiltasten der Galerie, und die sind Bedienelemente, keine Zierde.
interface Props {
  titel: string;
  kurz: string;
  punkte: string[];
}
const { titel, kurz, punkte } = Astro.props;
---

<article class="service rise">
  <h3>{titel}</h3>
  <p>{kurz}</p>
  <ul>
    {punkte.map((p) => <li>{p}</li>)}
  </ul>
</article>
