---
import LeistungIcon from './LeistungIcon.astro';

interface Props {
  icon: 'gelenk' | 'kette' | 'siegel';
  titel: string;
  kurz: string;
  punkte: string[];
}
const { icon, titel, kurz, punkte } = Astro.props;
---

<article class="service rise">
  <LeistungIcon name={icon} />
  <h3>{titel}</h3>
  <p>{kurz}</p>
  <ul>
    {punkte.map((p) => <li>{p}</li>)}
  </ul>
</article>
