---
// Icons der Leistungskarten — ersetzen die früheren Ziffern 01/02/03.
//
// GESTALTUNGSPRINZIP: ein offener, fein gezogener Ring, in dem eine einzige
// Geste sitzt. Alle drei teilen denselben Ring — was sie unterscheidet, ist
// allein die Linie darin. Dadurch wirken sie als Satz, wie drei Signets,
// und nicht als drei zusammengesuchte Symbole.
//
// Der Ring ist bewusst nicht geschlossen: oben rechts bleibt eine Lücke,
// durch die die innere Linie hinausläuft. Diese eine Unregelmäßigkeit
// nimmt der Form das Mechanische — sie wirkt gezogen statt gezirkelt.
//
// Drei Fassungen waren vorher daneben:
//   1. Gegenständliche Piktogramme (Hand, Läufer, Schild) — Icon-Baukasten.
//   2. Geometrische Konstruktionen (Knoten, Drehpunkt, Doppelring) —
//      sauber, aber technische Diagramme.
//   3. Freie Bögen ohne Klammer — die drei Bogenlinien lasen sich als
//      WLAN-Zeichen, die geschwungene Linie als Flamme.
// Der offene Ring aus Fassung 3 war der einzige Treffer; er ist jetzt die
// gemeinsame Form.
//
// Strichstärke 0.85 bei 54px — die Seite lebt von Haarlinien, die Zeichen
// jetzt auch. Farbe kommt aus dem CSS (.service__icon).

interface Props {
  name: 'beweglichkeit' | 'aufbau' | 'erlaubnis';
}
const { name } = Astro.props;

const gemeinsam = {
  width: '54',
  height: '54',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '0.85',
  'stroke-linecap': 'round' as const,
  'aria-hidden': 'true',
};

// Der gemeinsame Ring: fast geschlossen, Lücke oben rechts.
const ring = 'M18.9 7.2a9 9 0 1 1-4.3-4';
---

{name === 'beweglichkeit' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Physiotherapie: eine ruhige S-Linie — die wiedergewonnene
        Beweglichkeit, die aufgerichtete Haltung. */}
    <path d={ring} />
    <path d="M9.2 16.9C13.2 15 10.4 9 14.4 7.1" />
  </svg>
)}

{name === 'aufbau' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Sport-Osteopathie: eine Linie, die ansteigt und über den Ring
        hinausführt — Belastbarkeit, die aufgebaut wird. */}
    <path d={ring} />
    <path d="M8.2 16.2C11 10.2 15.4 6.4 21.2 4.6" />
  </svg>
)}

{name === 'erlaubnis' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Sektorale Heilpraktik: der Haken, der aus dem Ring hinausläuft —
        eine Erlaubnis, als Signatur gesetzt statt als Stempel. */}
    <path d={ring} />
    <path d="m8.9 11.9 2.8 2.8 8.4-9.1" />
  </svg>
)}
