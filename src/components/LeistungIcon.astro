---
// Icons der Leistungskarten.
//
// Maßstab waren die Icons, die bis vor Kurzem in Kapitel 03 („Für wen?")
// standen: 26px, Strichstärke 1.5, durchgehend --accent (nicht gedeckt),
// 3px Versatz beim Überfahren. In Kapitel 03 sind sie inzwischen entfernt,
// weil dort allein die Überschrift vorne stehen soll — diese hier blieben.
// Damit sind sie jetzt die einzigen Bildzeichen dieser Art auf der Seite.
//
// Vier Fassungen davor gingen daneben, und zwar alle aus demselben Grund:
// Sie waren mit 46-54px etwa doppelt so groß und gedeckt statt blau. Dadurch
// standen sie als eigenständige Bildmarke über der Karte, statt wie in
// Kapitel 03 beiläufig über der Überschrift zu sitzen. Nicht die Zeichnung
// war das Problem, sondern ihr Auftritt.

interface Props {
  name: 'puls' | 'ziel' | 'siegel';
}
const { name } = Astro.props;

const gemeinsam = {
  width: '26',
  height: '26',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': 'true',
};
---

{name === 'puls' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Physiotherapie: Pulslinie — Behandlung und wiederhergestellte Funktion. */}
    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
  </svg>
)}

{name === 'ziel' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Sport-Osteopathie: Zielscheibe — Prävention und genaue Befundung. */}
    <circle cx="12" cy="12" r="10" />
    <circle cx="12" cy="12" r="6" />
    <circle cx="12" cy="12" r="2" />
  </svg>
)}

{name === 'siegel' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Sektorale Heilpraktik: Plakette mit Haken — die staatliche Erlaubnis. */}
    <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
    <path d="m9 12 2 2 4-4" />
  </svg>
)}
