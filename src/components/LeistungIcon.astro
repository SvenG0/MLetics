---
// Icons der Leistungskarten — ersetzen die früheren Ziffern 01/02/03.
//
// GESTALTUNGSPRINZIP: konstruierte Zeichen, keine gezeichneten Gegenstände.
// Der erste Entwurf arbeitete gegenständlich (Hand, laufende Figur, Schild)
// und wirkte dadurch wie aus einem Icon-Baukasten — Strichmännchen und
// Comic-Hand passen nicht zu einer Praxis, die mit Profisportlern arbeitet.
//
// Diese Fassung baut alle drei aus denselben Grundformen: Kreis, Gerade,
// Kreisbogen, auf dem 24er-Raster, Winkel in geraden Schritten. Dieselbe
// Logik wie die Haarlinien und die schmale Archivo auf der Seite: wenige,
// exakt gesetzte Elemente statt vieler erzählender Details. Die Zeichen
// tragen nicht allein die Bedeutung — die Überschrift steht direkt
// darunter. Sie tragen den Ton.
//
// Farbe kommt aus dem CSS (.service__icon), deshalb stroke="currentColor".

interface Props {
  name: 'gelenk' | 'kette' | 'siegel';
}
const { name } = Astro.props;

const gemeinsam = {
  width: '48',
  height: '48',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.25',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': 'true',
};
---

{name === 'gelenk' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Physiotherapie: ein Segment schwingt um einen Drehpunkt — zwei
        Stellungen, dazwischen der Weg. Bewegungsumfang, wie er in der
        Befundung gemessen wird.

        Zwei Verwerfungen vorher: ein Goniometer aus zwei Schenkeln war
        unten links zusammengedrängt und der Bogen lief falsch herum;
        danach Punkt mit aufsteigenden Bögen — das liest sich zwingend als
        WLAN-Symbol. Diese Fassung nutzt denselben Knotenpunkt wie die
        Kette daneben, die drei Zeichen wirken dadurch als Satz. */}
    <circle cx="7" cy="17" r="1.9" />
    <path d="M7 15.1V6.5" />
    <path d="m8.5 15.8 6.5-5.5" />
    <path d="M7 6.5A10.5 10.5 0 0 1 15 10.3" />
  </svg>
)}

{name === 'kette' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Sport-Osteopathie: drei verbundene Punkte — die funktionelle Kette.
        Der Kern der Leistung ist, dass die Ursache selten dort liegt, wo es
        weh tut; das Zeichen zeigt Zusammenhang, nicht Sport. */}
    <circle cx="5.6" cy="6.2" r="2.1" />
    <circle cx="18.4" cy="10.4" r="2.1" />
    <circle cx="9.8" cy="18.9" r="2.1" />
    <path d="M7.6 6.9 16.4 9.8" />
    <path d="M17.5 12.3 10.8 17" />
    <path d="M6.2 8.2 9.2 16.9" />
  </svg>
)}

{name === 'siegel' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Sektorale Heilpraktik: Siegel — zwei konzentrische Ringe mit Haken,
        die Form amtlicher Beglaubigung. Bewusst kein Schild: das steht für
        Abwehr und Sicherheitssoftware, hier geht es um eine Erlaubnis. */}
    <circle cx="12" cy="12" r="9.1" />
    <circle cx="12" cy="12" r="6.4" />
    <path d="m9.4 12.1 1.9 1.9 3.6-4" />
  </svg>
)}
