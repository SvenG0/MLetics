---
// Icons der Leistungskarten — ersetzen die früheren Ziffern 01/02/03.
//
// Dieselbe Strichsprache wie die Icons im Kapitel „Für wen?" (24er-Raster,
// runde Enden, keine Flächen), aber im Auftritt der Ziffern, die sie
// ablösen: groß, nur konturiert, gedeckt — und erst beim Überfahren bzw.
// Vorbeiscrollen im Markenblau. Deshalb stroke="currentColor" und die Farbe
// aus dem CSS (.service__icon), nicht hier fest verdrahtet.
//
// Zwei Lehren aus dem ersten Entwurf:
//   1. Eine Wirbelsäule aus geschwungener Linie plus Querstrichen war bei
//      46px nicht als solche zu erkennen — es blieb ein Gekritzel. Die Hand
//      sagt dasselbe („manuelle Behandlung") in einer Form, die auch klein
//      noch eindeutig ist.
//   2. Die Formen füllten ihr Feld nicht aus und wirkten deshalb verloren
//      neben den kräftigen Ziffern. Jetzt reichen alle drei nah an die
//      Kanten des 24er-Rasters.
// Strichstärke 1.25 ergibt bei 48px rund 2,5px — etwas kräftiger als die
// 1,5px Konturstärke der alten Ziffern, weil offene Formen sonst gegen
// geschlossene Zahlenkörper optisch verlieren.

interface Props {
  name: 'hand' | 'laeufer' | 'erlaubnis';
}
const { name } = Astro.props;

const gemeinsam = {
  width: '48',
  height: '48',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.25',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': 'true',
};
---

{name === 'hand' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Physiotherapie: Hand — steht für die manuelle Behandlung, die den
        Kern dieser Leistung ausmacht. Bewusst GEKIPPT: aufrecht und
        frontal gelesen ist eine offene Handfläche das Zeichen für
        „Stopp". Schräg gestellt wird daraus eine Hand, die zugreift. */}
    <g transform="rotate(-32 12 12)">
      <path d="M18 11V6.2a2 2 0 0 0-4 0" />
      <path d="M14 10V4.2a2 2 0 0 0-4 0V6" />
      <path d="M10 10.5V6.2a2 2 0 0 0-4 0v8.4" />
      <path d="M18 8.2a2 2 0 0 1 4 0V14a8 8 0 0 1-8 8h-1.6c-2.8 0-4.6-.9-6.1-2.4l-3.7-3.7a2 2 0 0 1 2.9-2.9L7.4 15" />
    </g>
  </svg>
)}

{name === 'laeufer' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Sport-Osteopathie: laufende Figur — nimmt den Läufer aus dem
        Logo auf, ohne ihn zu kopieren. */}
    <circle cx="15.4" cy="3.9" r="2.1" />
    {/* Rumpf, nach vorn geneigt */}
    <path d="M13.6 7.6 10.6 13.2" />
    {/* Vorderes Bein: Knie angehoben, Unterschenkel nach unten */}
    <path d="M10.6 13.2 14.6 14.2 13.8 18.8" />
    {/* Hinteres Bein: nach hinten gestreckt */}
    <path d="M10.6 13.2 7.9 17 4.6 19.2" />
    {/* Vorderer Arm, angewinkelt */}
    <path d="M13.6 7.6 17.3 9.4 18.1 13" />
    {/* Hinterer Arm */}
    <path d="M13.6 7.6 9.7 8.7 7.1 11.5" />
  </svg>
)}

{name === 'erlaubnis' && (
  <svg class="service__icon" {...gemeinsam}>
    {/* Sektorale Heilpraktik: Schild mit Haken — steht für die staatliche
        Erlaubnis, eigenständig zu befunden und zu behandeln. */}
    <path d="M12 1.8 3.4 5.2v6.2c0 5.2 3.5 9.3 8.6 10.8 5.1-1.5 8.6-5.6 8.6-10.8V5.2L12 1.8z" />
    <path d="m8.3 11.9 2.6 2.7 4.8-5.2" />
  </svg>
)}
