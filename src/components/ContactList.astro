---
import praxis from '../data/praxis.json';

const zeilenStil = 'font-weight:400;font-size:1rem;line-height:1.6';
---

<dl class="contact-list rise">
  {/* Telefonnummer auf Wunsch raus — wie im Formular und im Handy-Menue.
      Sie steht weiterhin in Impressum und Datenschutzerklaerung: dort ist
      sie eine Pflicht- bzw. Kontaktangabe und keine Werbeflaeche. */}
  <div>
    <dt>E-Mail</dt>
    <dd><a href={`mailto:${praxis.email}`}>{praxis.email}</a></dd>
  </div>
  <div>
    <dt>Adresse</dt>
    <dd style={zeilenStil}>
      {praxis.adresse.strasse}<br />{praxis.adresse.plz} {praxis.adresse.ort}
    </dd>
  </div>
  <div>
    <dt>Termine</dt>
    <dd style={zeilenStil}>
      {praxis.termine.map((zeile, i) => (
        <>{i > 0 && <br />}{zeile}</>
      ))}
    </dd>
  </div>
</dl>
