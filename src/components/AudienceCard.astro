---
// „Für wen?" — bewusst OHNE Bildzeichen: Die Überschrift soll allein
// vorne stehen. Vorher saß über ihr ein Icon in Markenblau (trend/herz);
// das zog den Blick zuerst auf sich.
interface Props {
  titel: string;
  text: string;
}
const { titel, text } = Astro.props;
---

<div class="audience__card rise">
  <p class="block-h3">{titel}</p>
  <p class="body">{text}</p>
</div>
