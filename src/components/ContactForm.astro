---
import { pfad } from '../lib/pfad';
---

<form class="form" id="form" action={pfad('/kontakt.php')} method="post">
  {/* Name und Telefon teilen sich eine Zeile (.row wird ab 640px
      zweispaltig). Telefon ist freiwillig — darum ohne required und mit
      dem Zusatz im Beschriftungstext, nicht nur als Platzhalter: Ein
      Platzhalter verschwindet beim Tippen, die Beschriftung bleibt. */}
  <div class="row">
    <div class="field">
      <label for="f-name">Name</label>
      <input id="f-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="f-tel">Telefon <span class="freiwillig">(optional)</span></label>
      <input id="f-tel" name="tel" type="tel" inputmode="tel" autocomplete="tel" />
    </div>
  </div>

  <div class="field">
    <label for="f-mail">E-Mail</label>
    <input id="f-mail" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for="f-art">Anliegen</label>
    <select id="f-art" name="anliegen">
      {/* Zog vorher die drei Leistungen aus derselben Quelle wie die
          Karten im Kapitel Treat. Auf Maiks Wunsch nur noch diese zwei —
          worum es genau geht, steht ohnehin in der Nachricht. */}
      <option>Ersttermin</option>
      <option>Sonstiges</option>
    </select>
  </div>

  <div class="field">
    <label for="f-msg">Nachricht</label>
    <textarea id="f-msg" name="nachricht" placeholder="Was führt Dich zu uns?"></textarea>
  </div>

  {/* Spam-Abwehr ohne Captcha. Ein Captcha waere eine Huerde fuer
      Menschen mit Behinderung und bindet meist einen US-Dienst ein.
      Stattdessen: ein Feld, das niemand sieht (automatische Skripte
      fuellen stumpf alles aus) und ein Zeitstempel (wer in unter drei
      Sekunden abschickt, hat nicht gelesen).
      aria-hidden und tabindex halten es auch von Screenreadern und der
      Tastaturreihenfolge fern. */}
  <div class="honigtopf" aria-hidden="true">
    <label for="f-web">Website (bitte frei lassen)</label>
    <input id="f-web" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="gestartet" id="f-start" value="" />

  <label class="consent">
    <input type="checkbox" id="f-ok" required />
    <span>Ich bin einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage
    gespeichert werden. Hinweise dazu in der <a href={pfad('/datenschutz')} style="color:var(--accent-text)">Datenschutzerklärung</a>.</span>
  </label>

  <button type="submit" class="btn btn--solid" style="justify-content:center">Anfrage senden</button>
  {/* Leer ist der Kasten unsichtbar (.meldung:empty). Er bleibt dabei im
      Dokument stehen, statt ein- und ausgehaengt zu werden — eine
      Live-Region meldet Aenderungen zuverlaessiger, wenn sie von Anfang
      an da ist. */}
  <p class="meldung" id="formNote" role="status" aria-live="polite"></p>
</form>
